APP_ENV=dev
DATABASE_URL=postgresql+asyncpg://kumurska:kumurska@localhost:5433/kumurska
REDIS_URL=redis://localhost:6379/0

# OTP (US-03)
OTP_LENGTH=4
OTP_TTL_SECONDS=300
OTP_RESEND_SECONDS=60
OTP_MAX_ATTEMPTS=5
# В prod задаётся только через переменные окружения
OTP_SECRET=change-me

# SMS (US-03): fake разрешён только при APP_ENV=dev или test,
# в prod приложение с ним не запустится
SMS_PROVIDER=fake

# JWT (US-03)
# В prod задаётся только через переменные окружения
JWT_SECRET=change-me
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# Изображения акций и событий (US-17): S3-совместимое хранилище, в dev — MinIO
S3_ENDPOINT_URL=http://localhost:9010
S3_REGION=us-east-1
S3_ACCESS_KEY=kumurska
S3_SECRET_KEY=kumurska-dev-secret
S3_BUCKET=kumurska-content
S3_PUBLIC_URL=http://localhost:9010/kumurska-content
